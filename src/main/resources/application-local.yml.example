# 이 파일을 복사해서 application-local.yml로 저장하고 실제 값을 채워넣으세요.
# application-local.yml은 .gitignore에 등록되어 커밋되지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/booktalk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: your_local_password
    driver-class-name: com.mysql.cj.jdbc.Driver

jwt:
  secret: replace-with-a-long-random-secret-key
  access-token-expire-ms: 3600000        # 1시간
  refresh-token-expire-ms: 1209600000    # 14일

oauth2:
  kakao:
    client-id: your-kakao-rest-api-key
    client-secret: your-kakao-client-secret   # 카카오 개발자 콘솔에서 "Client Secret 사용"을 켠 경우만 필요
    redirect-uri: http://localhost:3000/oauth/callback/kakao
  naver:
    client-id: your-naver-client-id
    client-secret: your-naver-client-secret
    redirect-uri: http://localhost:3000/oauth/callback/naver
  google:
    client-id: your-google-client-id
    client-secret: your-google-client-secret
    redirect-uri: http://localhost:3000/oauth/callback/google
  facebook:
    client-id: your-facebook-app-id
    client-secret: your-facebook-app-secret
    redirect-uri: http://localhost:3000/oauth/callback/facebook

aladin:
  # https://blog.aladin.co.kr/openapi/ 에서 TTBKey 발급 (승인까지 며칠 걸릴 수 있음)
  # 비워두면 알라딘 검색 없이 로컬 DB 검색만 동작합니다.
  ttb-key: your-aladin-ttb-key

aws:
  s3:
    bucket: booktalk-spine-images
    region: ap-northeast-2
  access-key: your-aws-access-key
  secret-key: your-aws-secret-key
