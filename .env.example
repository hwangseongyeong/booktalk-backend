# EC2 서버에서 이 파일을 복사해 .env로 저장하고 실제 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore에 이미 포함되어 있어 커밋되지 않는다.

# GitHub Actions가 이 값을 배포 시 자동으로 넘겨주므로, EC2의 .env에는 안 넣어도 됨.
# (로컬에서 수동으로 `docker compose pull`을 테스트하고 싶을 때만 직접 채우면 됨)
# ECR_REPOSITORY_URI=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/booktalk-backend:latest

MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# openssl rand -base64 32 등으로 충분히 긴 랜덤 문자열 생성해서 사용
JWT_SECRET=change-me-to-a-long-random-string

# Caddy가 리버스 프록시로 물려주는 실제 서비스 주소 (책등 이미지 public URL 조립에 사용)
PUBLIC_BASE_URL=https://api.booktalk.io.kr

# 책등 이미지 저장 방식: local(기본) | s3 | r2
# 프로덕션은 S3 사용. 자격증명은 EC2 인스턴스에 연결한 IAM Role(s3:PutObject 권한)로 처리하므로
# access-key/secret-key는 .env에 넣지 않는다.
#   - 사전 준비: EC2 인스턴스 프로파일에 s3:PutObject(대상 spines/*) 허용 IAM Role 연결
#   - 주의: 컨테이너에서 인스턴스 메타데이터(IMDSv2) 접근이 되려면 인스턴스의
#           메타데이터 hop limit을 2로 설정해야 한다 (기본 1이면 컨테이너가 롤 자격증명을 못 받음)
STORAGE_MODE=s3
S3_REGION=ap-northeast-2
S3_BUCKET=booktalk-spine-images-704805513982-ap-northeast-2-an
S3_PUBLIC_BASE_URL=https://booktalk-spine-images-704805513982-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com

# 사용자 업로드 이미지(프로필/모임/기록 사진) 저장소. 위 책등(STORAGE_MODE)과는 별개 버킷이다.
# local(기본) | s3. 프로덕션은 s3.
# 자격증명(택1):
#   (A) EC2 IAM Role 권장: 아래 ACCESS_KEY/SECRET_KEY를 비우면 기본 자격증명 체인으로 자동 사용.
#       사전 준비: EC2 인스턴스 역할에 s3:PutObject/s3:GetObject(대상 버킷/images/*) 허용 추가.
#       (책등용 역할에 이 버킷 권한을 함께 추가하면 된다. IMDSv2 hop limit=2 필요 — 위 주석 참고)
#   (B) 액세스 키 사용: ACCESS_KEY/SECRET_KEY를 채운다(전용 IAM 사용자 키 권장).
UPLOAD_STORAGE=s3
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=text42-images-704805513982-ap-northeast-2-an
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CloudFront 배포 도메인(선택). 설정하면 새 업로드는 이 CDN URL로 직접 서빙(백엔드/S3 egress 우회).
# 예: https://dxxxxxxxx.cloudfront.net  (비우면 백엔드 프록시로 서빙)
AWS_S3_PUBLIC_BASE_URL=

# 책등 일괄 재생성 API(POST /api/v1/admin/spines/regenerate) 보호용 토큰.
# 비워두면 해당 API는 항상 403(비활성). 재생성이 필요할 때만 충분히 긴 랜덤값으로 설정.
#   호출: curl -X POST https://api.booktalk.io.kr/api/v1/admin/spines/regenerate -H "X-Admin-Token: <값>"
ADMIN_API_TOKEN=

# 어드민 웹/어드민 API 권한을 줄 운영자 이메일(쉼표 구분). 앱 시작 시 해당 User를 ADMIN으로 승격.
# 관리자가 먼저 앱에 로그인해 계정이 생긴 뒤 이메일을 넣고 재기동한다. (이메일 없는 카카오 계정은 DB 직접 UPDATE)
ADMIN_BOOTSTRAP_EMAILS=

# 표지 이미지 프록시(Cloudflare Worker). 카카오 CDN이 서버(AWS) IP를 차단해 표지를 직접 못 받으므로,
# 비-AWS IP인 Worker 경유로 표지를 받는다. 배포는 cloudflare/cover-proxy/README.md 참고.
# 비워두면 프록시 없이 직접 조회(카카오 표지는 색상 폴백으로 나옴).
COVER_PROXY_BASE_URL=
COVER_PROXY_TOKEN=

OAUTH2_KAKAO_CLIENT_ID=
OAUTH2_KAKAO_CLIENT_SECRET=
OAUTH2_KAKAO_REDIRECT_URI=https://booktalk.io.kr/oauth/callback/kakao

OAUTH2_NAVER_CLIENT_ID=
OAUTH2_NAVER_CLIENT_SECRET=
OAUTH2_NAVER_REDIRECT_URI=https://booktalk.io.kr/oauth/callback/naver

OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=https://booktalk.io.kr/oauth/callback/google

OAUTH2_FACEBOOK_CLIENT_ID=
OAUTH2_FACEBOOK_CLIENT_SECRET=
OAUTH2_FACEBOOK_REDIRECT_URI=https://booktalk.io.kr/oauth/callback/facebook
